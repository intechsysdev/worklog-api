{
  "ConnectionStrings": {
    "Default": ""
  },
  "Auth": {
    "Mode": "One"
  },
  "One": {
    "BaseUrl": "",
    "AppSlug": "worklog",
    "TimeoutSeconds": 10
  },
  "Storage": {
    "LocalPath": "App_Data/files"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5174" ],
    "AllowedOriginPatterns": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": { "path": "logs/worklog-api-.log", "rollingInterval": "Day", "retainedFileCountLimit": 14 }
      }
    ]
  },
  "AllowedHosts": "*"
}
