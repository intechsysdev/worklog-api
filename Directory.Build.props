<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: no todo miembro público necesita comentario XML. -->
    <!-- CA1848/CA1873: LoggerMessage delegates no compensan en este volumen. -->
    <!-- CA1711/CA1716/CA1720: nombres de dominio (Group, Shared…) son deliberados. -->
    <!-- CA2007: ASP.NET Core no tiene SynchronizationContext. -->
    <!-- CA1062: Nullable ya cubre la validación de argumentos. -->
    <NoWarn>$(NoWarn);CS1591;CS1573;CA1000;CA1859;CA1848;CA1873;CA1711;CA1716;CA1720;CA2007;CA1062;CA1724;CA1034;CA1819;CA2227;CA1002;CA1056;CA1054;CA1055;CA1307;CA1309;CA1305;CA1304;CA1311;CA1031;CA1805;CA1812;CA1852</NoWarn>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
</Project>
